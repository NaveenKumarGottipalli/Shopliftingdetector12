    "UCF-Crime_parents_of_DCSASS": 28
  },
  "frames_per_clip": 32,
  "image_size": 224,
  "long_video_seek_threshold_sec": 20.0,
  "normalization": {
    "clip": {
      "mean": [
        0.48145466,
        0.4578275,
        0.40821073
      ],
      "std": [
        0.26862954,
        0.26130258,
        0.27577711
      ]
    },
    "siglip": {
      "mean": [
        0.5,
        0.5,
        0.5
      ],
      "std": [
        0.5,
        0.5,
        0.5
      ]
    }
  },
  "backbones": {
    "clip_b16": "openai/clip-vit-base-patch16",
    "siglip_b16": "google/siglip-base-patch16-224",
    "clip_l14": "openai/clip-vit-large-patch14"
  },
  "trained_backbones": [
    "clip_b16",
    "clip_l14"
  ],
  "strict_scene_clusters": {
    "DCSASS": 28,
    "MNNIT-S3": 64,
    "Shop-Dataset": 15,
    "UCF-Crime": 68
  },
  "mil_head": {
