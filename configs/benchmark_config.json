{
  "repository": "https://github.com/NaveenKumarGottipalli/Shopliftingdetector",
  "dataset_repo": "https://huggingface.co/datasets/NaveenKumarGottipalli/Shoplifting_DataCollection",
  "version": "2.0.0",
