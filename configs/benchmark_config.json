    "epochs": 25,
    "seeds_lodo": [
      0,
      1,
      2
    ],
    "seeds_cv": [
      0,
      1
    ],
    "ablation_methods": [
      "base",
      "center",
      "dro",
      "center+dro"
    ],
    "scene_center_min_clips": 8,
    "group_dro_step_size": 0.01
  },
  "bootstrap_replicates": 500,
  "prompts": {
    "pos_2": [
      "a person shoplifting in a store",
      "a person hiding merchandise in a pocket or bag"
    ],
    "neg_2": [
      "a customer shopping normally in a store",
      "an empty store aisle"
    ],
    "pos_8": [
      "a person shoplifting in a store",
      "a person hiding merchandise in a pocket or bag",
      "a shopper concealing an item under their jacket",
      "a thief stealing products from a shelf",
      "a person putting store items into their bag without paying",
      "a person secretly pocketing an item in a shop",
      "a customer stuffing goods into a backpack",
      "someone stealing from a retail store"
    ],
    "neg_8": [
      "a customer shopping normally in a store",
      "an empty store aisle",
      "a shopper browsing products on a shelf",
      "a customer pushing a shopping cart",
      "a person paying at a checkout counter",
      "a customer walking through a store aisle",
      "a shop assistant stocking shelves",
      "people queuing in a shop"
    ]
  }
